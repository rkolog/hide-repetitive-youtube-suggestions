{
  "manifest_version": 2,
  "name": "Hide Repetitive YouTube Suggestions",
  "version": "1.2",
  "description": "Hides YouTube home page and watch page suggestions that have appeared more times than the limit user sets.",
  "author": "rkolog",
  "homepage_url": "https://github.com/rkolog/hide-repetitive-youtube-suggestions",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "Hide Repetitive Youtube Suggestions",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hide-rpt-yt-suggestions@rkolog",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
